+def test_jwt_without_subject_returns_401(protected_client: TestClient) -> None:
+    token = jwt.encode(
+        {"role": "user", "exp": datetime.now(timezone.utc) + timedelta(minutes=5)},
+        JWT_SECRET,
+        algorithm=JWT_ALGORITHM,
+    )
+
+    response = protected_client.get(
+        "/protected",
+        headers={"Authorization": f"Bearer {token}"},
+    )
+
+    assert response.status_code == 401
+
+
+@pytest.mark.parametrize(
+    ("claims", "expected_kind"),
+    [
+        ({"kind": "user", "role": "admin"}, "user"),
+        ({"kind": "service", "role": "service"}, "service"),
+        ({"role": "user"}, "user"),
+        ({"role": "service"}, "service"),
+    ],
+)
+def test_valid_jwt_exposes_token_kind(
+    claims: dict[str, str], expected_kind: str
+) -> None:
+    test_app = FastAPI()
+    test_app.add_middleware(JWTAuthenticationMiddleware)
+
+    @test_app.get("/protected")
+    def protected(request: Request) -> dict[str, str]:
+        return {"kind": request.state.kind}
+
+    response = TestClient(test_app).get(
+        "/protected",
+        headers={"Authorization": f"Bearer {create_token(**claims)}"},
+    )
+
+    assert response.json() == {"kind": expected_kind}
+
+
