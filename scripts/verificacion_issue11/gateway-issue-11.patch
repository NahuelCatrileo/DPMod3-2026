+@pytest.mark.parametrize(
+    "path",
+    ["/api/auth/register", "/api/auth/login", "/api/auth/refresh", "/api/auth/logout"],
+)
+def test_module3_session_routes_are_public_and_forward_cookies(
+    routing_client: tuple[TestClient, list[httpx.Request]],
+    path: str,
+) -> None:
+    client, observed = routing_client
+
+    response = client.post(path, headers={"Cookie": "pubtube_refresh=current"})
+
+    assert response.status_code == 200
+    assert len(observed) == 1
+    assert str(observed[0].url) == f"http://module3.test{path}"
+    assert observed[0].headers["Cookie"] == "pubtube_refresh=current"
+
+
+def test_module3_refresh_returns_the_rotated_cookie(
+    routing_client: tuple[TestClient, list[httpx.Request]],
+) -> None:
+    client, _ = routing_client
+
+    response = client.post("/api/auth/refresh")
+
+    assert response.headers["set-cookie"] == (
+        "pubtube_refresh=rotated; HttpOnly; Path=/api/auth; SameSite=strict"
+    )
+    assert response.json()["access_token"] == "module3-user-jwt"
+
+
+def test_module3_current_user_requires_jwt(
+    routing_client: tuple[TestClient, list[httpx.Request]],
+) -> None:
+    client, observed = routing_client
+
+    assert client.get("/api/auth/me").status_code == 401
+    assert observed == []
+
+    response = client.get(
+        "/api/auth/me", headers={"Authorization": f"Bearer {create_token()}"}
+    )
+
+    assert response.status_code == 200
+    assert str(observed[0].url) == "http://module3.test/api/auth/me"
+    assert observed[0].headers["Authorization"].startswith("Bearer ")
+
+
