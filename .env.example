─────────────────────────────────────────────────────────

APP_ENV=dev
LOG_LEVEL=INFO
MODULE_NAME=module-3

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg2://pubtube:pubtube@postgres:5432/pubtube_m3
POSTGRES_USER=pubtube
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=pubtube_m3

# --- US-C4: conmutación del publicador ---
# mock    -> no toca la red, no gasta cuota
# youtube -> requiere OAuth (Sprint 3)
PUBLISHER_MODE=mock
MOCK_LATENCY_SECONDS=0.5
MOCK_FAILURE_RATE=0.0

# --- Transporte de eventos ---
# log  -> doble de prueba (default mientras Equipo B no confirme el exchange)
# amqp -> RabbitMQ real
EVENT_TRANSPORT=log
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
AMQP_EXCHANGE=pubtube.events

# --- US-C2: scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
SCHEDULER_TIMEZONE=UTC
# Reconciliación publication <-> job store (ADR-0004), en segundos
SCHEDULER_RECONCILE_SECONDS=60

# --- US-C5: política de reintentos (ADR-0006) ---
# Intentos totales antes de emitir publish.failed (contador por publicación)
PUBLISH_MAX_ATTEMPTS=3
# Base del backoff exponencial para errores TRANSITORIOS: 60, 120, 240 ...
PUBLISH_RETRY_BACKOFF_SECONDS=60
# Retraso fijo para DIFERIBLES (QUOTA_EXCEEDED): la cuota se restablece
# por ventana, reintentar antes solo gasta cuota
PUBLISH_QUOTA_RETRY_SECONDS=3600
# Código que usa el mock al fallar. Debe ser de la clase que se quiera
# demostrar: QUOTA_EXCEEDED (diferible), OAUTH_ERROR (definitivo),
# PUBLISH_FAILED (transitorio)
MOCK_FAILURE_CODE=QUOTA_EXCEEDED

# --- US-C3: OAuth 2.0 con Google para publicar en YouTube (ADR-0008) ---
# Cliente OAuth de tipo "Aplicación web" de Google Cloud. Paso a paso en
# docs/oauth-youtube.md. El secreto va solo aquí, nunca en el repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe ser idéntica a una "URI de redireccionamiento autorizada" del cliente.
OAUTH_REDIRECT_URI=http://localhost:8000/oauth2/callback
# Clave Fernet que cifra los tokens de Google en la base. Genérela con:
#   docker compose run --rm --no-deps module3 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si cambia o se pierde, hay que volver a autorizar la cuenta.
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- US-C3.4: metadatos del Módulo 1 ---
# URL interna del M1 para GET /api/content/{contentId}/metadata.
# En Docker Compose de integración suele ser http://module1-api:8000.
MODULE1_BASE_URL=http://module1-api:8000
MODULE1_TIMEOUT_SECONDS=5

# --- US-C3.5: subida real a YouTube ---
# Carpeta con los videos a subir, nombrados <contentId>.<ext> (mp4, mov, mkv,
# webm, avi o m4v). Los metadatos ya vienen del M1; el archivo sigue siendo
# provisional hasta que M1 exponga descarga o URL prefirmada (US-C3.4).
YOUTUBE_VIDEO_DIR=videos

# --- Autenticación de la API con JWT (ADR-0005) ---
# Este módulo firma los tokens (ADR-0007) y el API Gateway (Equipo D) los
# valida: debe ser el mismo valor que JWT_SECRET del gateway. Genérela con
# openssl rand -hex 32 y compártala por un canal privado, nunca en el repo.
# Con APP_ENV=prod el módulo no firma con este valor de ejemplo.
JWT_SECRET_KEY=genere-uno-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
# Opcionales: si se completan, el token debe traer esos iss / aud.
# Deje JWT_AUDIENCE vacío: el gateway rechaza los tokens que traen aud.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_LEEWAY_SECONDS=30

# --- Emisión de tokens a clientes de servicio (ADR-0007) ---
# JSON {client_id: {"secret_hash": "...", "role": "..."}}. Genere cada
# entrada con: python scripts/generar_cliente.py --client-id <id>
# Vacío = POST /api/auth/token no entrega tokens a nadie.
AUTH_CLIENTS={}
JWT_ACCESS_TOKEN_MINUTES=30

# --- Cuentas de usuario y sesiones (issue #11, ADR-0009) ---
# Días que dura una sesión sin uso. Cada refresh rota la cookie y reinicia
# el plazo.
AUTH_REFRESH_TOKEN_DAYS=7
# Cookie del refresh token. Secure exige HTTPS; los navegadores la aceptan
# también en http://localhost. Use AUTH_COOKIE_SAMESITE=none solo si la UI
# está en otro dominio que el gateway (exige Secure y CORS en el gateway).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
# Orígenes de la UI (esquema://host[:puerto], separados por comas). Si refresh
# o logout traen Origin y no está aquí, responden 403. Vacío = no se revisa
# Origin; la cabecera X-CSRF-Protection se exige siempre.
AUTH_ALLOWED_ORIGINS=
